# Copy to .env.local for local runs. In GitHub Actions, set these as repository secrets.

# Required by SEC EDGAR: a project/name and a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="your-project-name you@example.com"

# Optional: raises OpenFIGI rate limits from 25 req/min to 25 req/6s (free key at https://www.openfigi.com/api).
OPENFIGI_API_KEY=
